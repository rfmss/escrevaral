{
  "name": "escrevaral-mass-notes-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:anatomy": "node scripts/prepare-anatomy.mjs",
    "prepare:blueprint": "node scripts/prepare-blueprint.mjs",
    "prepare:assets": "npm run prepare:anatomy && npm run prepare:blueprint",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tiptap/core": "3.29.1",
    "@tiptap/extensions": "3.29.1",
    "@tiptap/pm": "3.29.1",
    "@tiptap/react": "3.29.1",
    "@tiptap/starter-kit": "3.29.1",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "@types/node": "^24.0.0"
  },
  "overrides": {
    "@tiptap/core": "3.29.1",
    "@tiptap/extensions": "3.29.1",
    "@tiptap/pm": "3.29.1"
  }
}
